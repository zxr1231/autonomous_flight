<launch>
	<arg name="terminal_recovery" default="false" />
	<param name="/autonomous_flight/terminal_recovery" value="$(arg terminal_recovery)" type="bool" />
	<arg name="exact_start" default="false" />
	<param name="/bspline_traj/exact_start" value="$(arg exact_start)" type="bool" />
	<arg name="turn_sync_mode" default="serial" />
	<param name="/autonomous_flight/turn_sync_mode" value="$(arg turn_sync_mode)" type="str" />
	<arg name="benchmark_seed" default="1" />
	<arg name="path_gain_mode" default="legacy" />
	<arg name="route_control_mode" default="historical_legacy" />
	<arg name="diagnostic_snapshot_enabled" default="false" />
	<arg name="diagnostic_snapshot_directory" default="/tmp/cerlab_r2_snapshots" />
	<arg name="depth_image_topic" default="/camera/depth/image_raw" />
	<arg name="depth_filter_invalid" default="false" />
	<arg name="depth_track_valid_observations" default="false" />
	<arg name="depth_evidence_arm" default="" />
	<remap from="/mavros/local_position/odom" to="CERLAB/quadcopter/odom" />
	<remap from="/mavros/setpoint_raw/local" to="CERLAB/quadcopter/cmd_acc" />
	<rosparam file="$(find tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen" />

	<rosparam file="$(find autonomous_flight)/cfg/dynamic_inspection/fake_detector_param.yaml" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/flight_base.yaml" ns="autonomous_flight"/>
	<param name="/autonomous_flight/depth_evidence/arm" value="$(arg depth_evidence_arm)" type="str" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/exploration_param.yaml" ns="DEP"/>
	<param name="/DEP/random_seed" value="$(arg benchmark_seed)" type="int" />
	<param name="/DEP/route_controls/mode" value="$(arg route_control_mode)" type="str" />
	<param name="/DEP/path_gain/mode" value="$(arg path_gain_mode)" type="str" />
	<param name="/DEP/diagnostics/snapshot_enabled" value="$(arg diagnostic_snapshot_enabled)" type="bool" />
	<param name="/DEP/diagnostics/snapshot_directory" value="$(arg diagnostic_snapshot_directory)" type="str" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/planner_param.yaml" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/dynamic_detector_param.yaml" ns="/onboard_detector" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/mapping_param.yaml" ns="/dynamic_map" />
	<param name="/dynamic_map/depth_image_topic" value="$(arg depth_image_topic)" type="str" />
	<param name="/dynamic_map/depth_evidence/filter_invalid" value="$(arg depth_filter_invalid)" type="bool" />
	<param name="/dynamic_map/depth_evidence/track_valid_observations" value="$(arg depth_track_valid_observations)" type="bool" />

	<node pkg="autonomous_flight" type="throttle_topics.sh" name="throttle_topics" />
	<node pkg="autonomous_flight" type="dynamic_exploration_node" name="dynamic_exploration_node" output="screen" />
</launch>
